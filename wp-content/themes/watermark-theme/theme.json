      "h3": {},
      "h4": {},
      "h5": {},
      "h6": {},
      "link": {}
    },
    "typography": {},
    "blocks": {
      "core/button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--black)"
        },
        "typography": {
          "fontStyle": "normal",
          "fontWeight": "700",
          "textTransform": "uppercase"
        }
      }
    }
  }
}
